# Values in this file override variables inherited from the shell (main.py loads it with override=True).
# OpenRouter (개발). base_url 뒤에 /v1/messages는 SDK가 붙인다.
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_AUTH_TOKEN=sk-or-v1-여기에키
# ANTHROPIC_API_KEY is left unset on purpose: with it set (even empty) the SDK sends X-Api-Key and never the Bearer token.
# 모델: OpenRouter 슬러그. https://openrouter.ai/models 에서 "tools" 지원 필터로 고른다.
ATWORKS_MODEL=qwen/qwen3.5-397b-a17b
ATWORKS_PORT=8010
# 리포트 페이지의 "채팅에서 보기" 링크가 가리키는 포털 오리진 (web/atworks-web)
ATWORKS_PORTAL_ORIGIN=http://localhost:3110
# 폐쇄망: vLLM(Qwen) 앞 LiteLLM 프록시 — 위 두 줄만 바꾼다 (docs/sllm-seam.md)
# ANTHROPIC_BASE_URL=http://litellm.internal:4000
# ANTHROPIC_AUTH_TOKEN=sk-litellm-…
# ATWORKS_TRUST_OS_CA=1  # default 1: Python trusts the OS certificate store (corporate/proxy CAs); set 0 to use certifi only
